# Caminho opcional para o arquivo SQLite
# Padrão: ./data/festpay-docs.sqlite (dev) ou /tmp/festpay-docs.sqlite (produção serverless)
# Em produção serverless (Vercel), /tmp é efêmero e não persiste entre instâncias
DATABASE_PATH=

# Para persistência em produção, configure Turso (opcional, requer migração para async)
# TURSO_DATABASE_URL=libsql://[nome].turso.io
# TURSO_AUTH_TOKEN=seu-token-aqui

# Quando preenchida, protege o endpoint /api/mcp com Authorization: Bearer <chave>
MCP_API_KEY=
