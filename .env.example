# Neon Postgres (Vercel Marketplace: vercel integration add neon)
DATABASE_URL=

# Auth.js v5 — GitHub OAuth App (callback: /api/auth/callback/github)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Local: http://localhost:3000 — produção / agentes: https://portulan.vercel.app
# CLI e agentes: PORTULAN_ENDPOINT=https://portulan.vercel.app
# Se usar `vercel env pull`, sobrescreva AUTH_URL aqui antes de `npm run dev`.
AUTH_URL=

# Vercel Blob (vercel integration add blob)
# Copie do dashboard (Storage → Blob → .env.local) ou rode: npx vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
